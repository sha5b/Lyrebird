\@writefile{toc}{\contentsline {paragraph}{Anatomy cannot be inferred from song at this scale, and the two available excuses are closed.}{31}{section*.36}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The pipeline recovers the textbook relationship, which is what makes the negative result above worth reading.}{31}{section*.37}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A recordist-blocked split costs a probe over frozen foundation-model features 18.51 points of top-1 on Perch and 21.59 on BirdNET, and the gate is met on both.}{32}{section*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The recordist structure is visible to an outside model on recordings it has never seen.}{32}{section*.39}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Aggregating to one point per recording does not remove the confound, and the test that appears to say otherwise is selecting its own answer.}{32}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Whether vocal learners have more complex song cannot be asked of this corpus, and that is a statement about our measures and not a null about birds.}{32}{section*.41}\protected@file@percent }
