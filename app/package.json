{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"description": "Lyrebird: browser half — realtime syrinx synthesis, mic analysis, the galaxy.",
	"license": "CC-BY-NC-SA-4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"verify:synth": "node scripts/render-syllable.mjs",
		"demo:wav": "node scripts/render-syllable.mjs --wav out/wav",
		"verify:features": "node --experimental-strip-types scripts/verify-features.mjs",
		"verify:layout": "node --experimental-strip-types scripts/verify-layout.mjs",
		"verify:split-knots": "node --experimental-strip-types scripts/verify-split-knots.mjs",
		"verify:trajectory": "node --experimental-strip-types scripts/verify-trajectory.mjs",
		"verify:inventory-table": "node --experimental-strip-types scripts/verify-inventory-table.mjs",
		"measure:layout": "node --experimental-strip-types --max-old-space-size=4096 scripts/measure-layout.mjs",
		"verify:biplot": "node --experimental-strip-types scripts/verify-biplot.mjs",
		"verify:performance": "node --experimental-strip-types scripts/verify-performance.mjs",
		"verify:context-threads": "node --experimental-strip-types scripts/verify-context-threads.mjs",
		"verify:zip": "node --experimental-strip-types scripts/verify-zip.mjs",
		"verify:ticks": "node --experimental-strip-types scripts/verify-ticks.mjs",
		"verify:fade": "node --experimental-strip-types scripts/verify-fade.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"@types/three": "^0.185.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"meyda": "^5.6.3",
		"pitchy": "^4.1.0",
		"three": "^0.185.1"
	}
}
