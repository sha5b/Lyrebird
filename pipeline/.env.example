# Copy this file to `pipeline/.env` and fill in your key:
#
#     cd pipeline && cp .env.example .env
#
# `.env` is gitignored. The key belongs to you, it is rate-limited per account, and it
# must not end up in a commit.
#
# Nothing in `app/` reads this. The browser never talks to xeno-canto — harvesting is an
# offline step, so the key is only ever seen by the Python pipeline. An `app/.env` would
# be shipped to the browser by Vite, which is exactly what you do not want.

# xeno-canto API v3 key. Create one at https://xeno-canto.org/account
# (v2 is retired; v3 requires a key and applies rate limits).
XC_API_KEY=paste-your-key-here

# Optional. Seconds to wait between requests to xeno-canto. The default is polite;
# lowering it risks being blocked, and a research corpus is not worth that.
# BIRDY_XC_PAUSE=1.0
